# ============================================================
# EliteEvents Co. — Server Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server port (default: 3000)
PORT=3000

# Destination email address for contact form enquiries
# This is where all enquiry emails will be sent
BUSINESS_EMAIL=hello@eliteevents.co

# ── SMTP Configuration ──────────────────────────────────────
# For Gmail: use smtp.gmail.com + App Password (NOT your Gmail password)
# For Mailtrap testing: use sandbox.smtp.mailtrap.io + your Mailtrap credentials
SMTP_HOST=messiahevents07@gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your SMTP account username (usually your email address)
SMTP_USER=messiahevents07@gmail.com

# For Gmail: Generate an App Password at:
# Google Account → Security → 2-Step Verification → App Passwords
# For Mailtrap: use the password from your Mailtrap inbox credentials
SMTP_PASS=yhls isww qyff lsvf
